# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# =====================================================================
# SUPABASE CONFIGURATION (Required for Auth, Database & RLS)
# =====================================================================
# Public client-side keys (safe for browser via Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side Supabase credentials (NEVER expose SERVICE_ROLE_KEY to browser)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated list of admin email addresses allowed to bootstrap/verify admin access
ADMIN_BOOTSTRAP_EMAILS=""

# =====================================================================
# WEB3FORMS CONFIGURATION (Server-side notification & enquiry forwarding)
# =====================================================================
WEB3FORMS_ACCESS_KEY=""
WEB3FORMS_RECIPIENT_EMAIL="educationatlas@gmail.com"

# =====================================================================
# OPTIONAL INITIAL MANUAL PAYMENT RECIPIENT CONFIGURATION
# Leave blank if configured dynamically via Admin Panel -> Payment Settings
# Never commit real personal numbers to public version control
# =====================================================================
BKASH_MERCHANT_OR_PERSONAL_NUMBER=""
BKASH_ACCOUNT_TYPE=""
NAGAD_MERCHANT_OR_PERSONAL_NUMBER=""
NAGAD_ACCOUNT_TYPE=""
